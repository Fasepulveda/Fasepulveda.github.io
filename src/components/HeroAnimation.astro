---
// HeroAnimation.astro
---

<canvas id="hero-canvas" class="fixed inset-0 pointer-events-none z-0"></canvas>

<script>
  const canvas = document.getElementById('hero-canvas') as HTMLCanvasElement;
  if (canvas) {
    const ctx = canvas.getContext('2d');
    
    let width = window.innerWidth;
    let height = window.innerHeight;
    canvas.width = width;
    canvas.height = height;

    // Start offscreen or at center
    let mouse = { x: width / 2, y: height / 2, vx: 0, vy: 0 };
    let smoothedMouse = { x: width / 2, y: height / 2 };
    let lastMouse = { x: width / 2, y: height / 2 };
    
    // Tech symbols
    const particles: any[] = [];
    const symbols = ['0', '1', '{}', '</>', '=>', '[]', 'const', 'let', 'func()', 'import', '&&', '||', ';', '#', '*', '10'];

    window.addEventListener('resize', () => {
      width = window.innerWidth;
      height = window.innerHeight;
      canvas.width = width;
      canvas.height = height;
    });

    window.addEventListener('mousemove', (e) => {
      lastMouse.x = mouse.x;
      lastMouse.y = mouse.y;
      mouse.x = e.clientX;
      mouse.y = e.clientY;
      mouse.vx = mouse.x - lastMouse.x;
      mouse.vy = mouse.y - lastMouse.y;
      
      const speed = Math.sqrt(mouse.vx**2 + mouse.vy**2);
      
      // Spawn particles more frequently when moving faster
      const spawnCount = Math.min(Math.floor(speed / 10), 3) + (Math.random() > 0.6 ? 1 : 0);
      
      for(let i=0; i<spawnCount; i++) {
        particles.push({
          x: mouse.x + (Math.random() - 0.5) * 80,
          y: mouse.y + (Math.random() - 0.5) * 80,
          vx: (Math.random() - 0.5) * 1.5 + mouse.vx * 0.02,
          vy: (Math.random() - 0.5) * 1.5 + mouse.vy * 0.02,
          life: 1,
          symbol: symbols[Math.floor(Math.random() * symbols.length)],
          size: Math.random() * 14 + 10,
          rotation: Math.random() * Math.PI * 2,
          vr: (Math.random() - 0.5) * 0.05
        });
      }
    });

    function drawAura() {
      if (!ctx) return;
      const gradient = ctx.createRadialGradient(
        smoothedMouse.x, smoothedMouse.y, 0,
        smoothedMouse.x, smoothedMouse.y, 500
      );
      // Colors match global.css variables but mapped to rgba
      gradient.addColorStop(0, 'rgba(139, 92, 246, 0.15)'); // Primary --color-primary
      gradient.addColorStop(0.5, 'rgba(59, 130, 246, 0.06)'); // Secondary --color-secondary
      gradient.addColorStop(1, 'rgba(15, 23, 42, 0)'); // Transparent BG

      ctx.fillStyle = gradient;
      ctx.fillRect(0, 0, width, height);
    }

    function animate() {
      if (!ctx) return;
      ctx.clearRect(0, 0, width, height);
      
      // Smooth mouse pursuit
      smoothedMouse.x += (mouse.x - smoothedMouse.x) * 0.08;
      smoothedMouse.y += (mouse.y - smoothedMouse.y) * 0.08;

      drawAura();

      ctx.textAlign = 'center';
      ctx.textBaseline = 'middle';
      
      for (let i = particles.length - 1; i >= 0; i--) {
        let p = particles[i];
        p.x += p.vx;
        p.y += p.vy;
        p.rotation += p.vr;
        p.life -= 0.01;

        if (p.life <= 0) {
          particles.splice(i, 1);
          continue;
        }

        ctx.save();
        ctx.translate(p.x, p.y);
        ctx.rotate(p.rotation);
        // Fade out text using muted text color --color-text-muted
        ctx.fillStyle = `rgba(148, 163, 184, ${p.life * 0.6})`; 
        ctx.font = `${p.size}px monospace`;
        ctx.fillText(p.symbol, 0, 0);
        ctx.restore();
      }

      requestAnimationFrame(animate);
    }
    
    animate();
  }
</script>
