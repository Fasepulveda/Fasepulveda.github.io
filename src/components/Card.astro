---
interface Props {
  title: string;
  href?: string;
  delay?: number;
}

const { title, href, delay = 0 } = Astro.props;
const delayClass = delay > 0 ? `stagger-${delay}` : '';
---
{href ? (
  <a href={href} class={`block glass p-6 rounded-2xl hover:scale-105 hover:-translate-y-1 transition-all duration-300 animate-fade-in-up ${delayClass} group hover:shadow-[var(--color-primary)]/20 hover:border-[var(--color-primary)]/50`}>
    <slot name="icon" />
    <h3 class="text-xl font-bold mb-2 group-hover:text-gradient inline-block">{title}</h3>
    <div class="text-[var(--color-text-muted)] group-hover:text-[var(--color-text-main)] transition-colors">
      <slot />
    </div>
  </a>
) : (
  <div class={`glass p-6 rounded-2xl animate-fade-in-up ${delayClass} hover:shadow-lg transition-shadow duration-300`}>
    <slot name="icon" />
    <h3 class="text-xl font-bold mb-2 text-gradient inline-block">{title}</h3>
    <div class="text-[var(--color-text-muted)] space-y-4">
      <slot />
    </div>
  </div>
)}
