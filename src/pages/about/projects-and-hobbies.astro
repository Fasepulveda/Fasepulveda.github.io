---
import Layout from "../../layouts/Layout.astro";
import {
  Gamepad2,
  Music,
  Cpu,
  ChefHat,
  ChevronLeft,
  ChevronRight,
  Play,
} from "lucide-astro";
---

<Layout
  title="Hobbies & Projects | Fernando Sepulveda"
  description="What I enjoy doing in my free time."
>
  <div
    class="max-w-6xl mx-auto mt-10 animate-fade-in-up"
    id="hobbies-container"
  >
    <div class="mb-12 flex items-center space-x-4 relative z-20">
      <div class="p-4 rounded-2xl glass bg-[var(--color-primary)]/10">
        <Gamepad2 class="w-12 h-12 text-[var(--color-primary)]" />
      </div>
      <div>
        <h1 class="text-4xl md:text-5xl font-extrabold tracking-tight">
          Hobbies & <span class="text-gradient">Projects</span>
        </h1>
        <p class="text-xl text-[var(--color-text-muted)] mt-2">
          What I enjoy doing in my free time and personal projects.
        </p>
      </div>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-8 relative z-20">
      <!-- Piano -->
      <div
        class="hobby-card cursor-pointer glass p-8 rounded-3xl group transition-all duration-500 ease-out hover:-translate-y-2 hover:shadow-[var(--color-secondary)]/20"
        data-target="carousel-piano"
      >
        <div
          class="bg-[var(--color-secondary)]/10 w-16 h-16 rounded-2xl flex items-center justify-center mb-6 transition-transform group-hover:scale-110 duration-300"
        >
          <Music class="w-8 h-8 text-[var(--color-secondary)]" />
        </div>
        <h2 class="text-2xl font-bold mb-4 text-white">Piano</h2>
        <p class="text-[var(--color-text-muted)] mb-4">
          Playing the piano is how I unwind. I enjoy learning classical pieces
          and modern soundtracks.
        </p>
        <p
          class="text-[var(--color-text-muted)] font-medium text-[var(--color-secondary)] group-hover:underline"
        >
          Click to explore &rarr;
        </p>
      </div>

      <!-- Hardware/Software -->
      <div
        class="hobby-card cursor-pointer glass p-8 rounded-3xl group transition-all duration-500 ease-out hover:-translate-y-2 hover:shadow-[var(--color-primary)]/20 stagger-1"
        data-target="carousel-projects"
      >
        <div
          class="bg-[var(--color-primary)]/10 w-16 h-16 rounded-2xl flex items-center justify-center mb-6 transition-transform group-hover:scale-110 duration-300"
        >
          <Cpu class="w-8 h-8 text-[var(--color-primary)]" />
        </div>
        <h2 class="text-2xl font-bold mb-4 text-white">
          Hardware & Software Projects
        </h2>
        <p class="text-[var(--color-text-muted)] mb-4">
          I enjoy combining my coding abilities with tangible hardware projects.
        </p>
        <p
          class="text-[var(--color-text-muted)] font-medium text-[var(--color-primary)] group-hover:underline"
        >
          Click to explore &rarr;
        </p>
      </div>

      <!-- Cooking -->
      <div
        class="hobby-card cursor-pointer glass p-8 rounded-3xl group transition-all duration-500 ease-out hover:-translate-y-2 hover:shadow-[var(--color-accent)]/20 stagger-2"
        data-target="carousel-cooking"
      >
        <div
          class="bg-[var(--color-accent)]/10 w-16 h-16 rounded-2xl flex items-center justify-center mb-6 transition-transform group-hover:scale-110 duration-300"
        >
          <ChefHat class="w-8 h-8 text-[var(--color-accent)]" />
        </div>
        <h2 class="text-2xl font-bold mb-4 text-white">Cooking</h2>
        <p class="text-[var(--color-text-muted)] mb-4">
          I love exploring new recipes and cooking meals for friends and family.
        </p>
        <p
          class="text-[var(--color-text-muted)] font-medium text-[var(--color-accent)] group-hover:underline"
        >
          Click to explore &rarr;
        </p>
      </div>
    </div>

    <!-- Detail View / Carousel Container -->
    <div
      id="detail-view"
      class="hidden mt-8 glass p-8 md:p-12 rounded-3xl relative overflow-visible transition-all duration-700 shadow-2xl border border-white/10 z-10"
    >
      <!-- Connecting Tab Arrow -->
      <div
        id="tab-caret"
        class="hidden md:block absolute top-[-1.25rem] w-10 h-10 glass border-t border-l border-white/10 transition-all duration-500 ease-out z-0"
        style="left: 50%; transform: translateX(-50%) rotate(45deg);"
      >
      </div>

      <!-- Piano Carousel -->
      <div id="carousel-piano" class="hobby-carousel hidden relative z-10">
        <div class="flex items-center justify-between mb-8">
          <h3 class="text-4xl font-bold text-white flex items-center">
            <Music class="w-10 h-10 mr-4 text-[var(--color-secondary)]" /> Piano Stories
          </h3>
          <div class="flex space-x-2">
            <button
              class="prev-btn p-4 rounded-full glass hover:bg-white/10 transition-colors z-40"
            >
              <ChevronLeft class="w-8 h-8 text-white" />
            </button>
            <button
              class="next-btn p-4 rounded-full glass hover:bg-white/10 transition-colors z-40"
            >
              <ChevronRight class="w-8 h-8 text-white" />
            </button>
          </div>
        </div>
        <div
          class="carousel-content relative h-[450px] w-full flex justify-center items-center"
          style="perspective: 1200px;"
        >
          <!-- Item 1 -->
          <div
            class="carousel-item absolute w-[95%] md:w-[75%] h-[380px] glass p-8 rounded-3xl border border-white/10 cursor-pointer flex flex-col justify-center text-center group"
          >
            <div class="text-5xl mb-3">🐀🥖</div>
            <h4 class="text-3xl font-bold text-[var(--color-secondary)] mb-4">
              Le Festin
            </h4>
            <p class="text-[0.95rem] text-[var(--color-text-muted)] leading-relaxed mb-6">
              A beautiful, evocative piece that transports listeners straight to the heart of Paris. Capturing the delicate waltz-like rhythm and the emotional depth of the melody on the piano is a uniquely rewarding challenge.
            </p>
            <a href="https://www.youtube.com/watch?v=R9hAcVfU3oI" target="_blank" class="inline-flex items-center justify-center mx-auto px-6 py-3 mt-auto rounded-full bg-[var(--color-secondary)] text-[var(--color-bg)] font-bold transition-transform hover:scale-105 relative z-50 pointer-events-auto">
              <Play class="w-5 h-5 mr-2" />
              Watch Tutorial
            </a>
          </div>
          <!-- Item 2 -->
          <div
            class="carousel-item absolute w-[95%] md:w-[75%] h-[380px] glass p-8 rounded-3xl border border-white/10 cursor-pointer flex flex-col justify-center text-center group"
          >
            <div class="text-5xl mb-3">🗼✨</div>
            <h4 class="text-3xl font-bold text-[var(--color-secondary)] mb-4">
              Les Champs-Élysées
            </h4>
            <p class="text-[0.95rem] text-[var(--color-text-muted)] leading-relaxed mb-6">
              An upbeat and undeniably joyful classic. Playing this on the piano requires a lively tempo and a bouncy left hand, perfectly reflecting the carefree spirit of a stroll down the famous Parisian avenue.
            </p>
            <a href="https://www.youtube.com/watch?v=2Dzc2pR2gnc&list=RD2Dzc2pR2gnc&start_radio=1" target="_blank" class="inline-flex items-center justify-center mx-auto px-6 py-3 mt-auto rounded-full bg-[var(--color-secondary)] text-[var(--color-bg)] font-bold transition-transform hover:scale-105 relative z-50 pointer-events-auto">
              <Play class="w-5 h-5 mr-2" />
              Watch Tutorial
            </a>
          </div>
          <!-- Item 3 -->
          <div
            class="carousel-item absolute w-[95%] md:w-[75%] h-[380px] glass p-8 rounded-3xl border border-white/10 cursor-pointer flex flex-col justify-center text-center group"
          >
            <div class="text-5xl mb-3">🎸🔥</div>
            <h4 class="text-3xl font-bold text-[var(--color-secondary)] mb-4">
              Hooked on a Feeling
            </h4>
            <p class="text-[0.95rem] text-[var(--color-text-muted)] leading-relaxed mb-6">
              A bold, energetic adaptation of Blue Swede's iconic track. Translating the driving rhythm, the memorable vocal hooks, and the overall grandness of the song into a solo piano arrangement makes for an incredibly fun performance.
            </p>
            <a href="https://www.youtube.com/watch?v=jBsW08B0LAs&list=RDjBsW08B0LAs&start_radio=1" target="_blank" class="inline-flex items-center justify-center mx-auto px-6 py-3 mt-auto rounded-full bg-[var(--color-secondary)] text-[var(--color-bg)] font-bold transition-transform hover:scale-105 relative z-50 pointer-events-auto">
              <Play class="w-5 h-5 mr-2" />
              Watch Tutorial
            </a>
          </div>
        </div>
      </div>

      <!-- Projects Carousel -->
      <div id="carousel-projects" class="hobby-carousel hidden relative z-10">
        <div class="flex items-center justify-between mb-8">
          <h3 class="text-4xl font-bold text-white flex items-center">
            <Cpu class="w-10 h-10 mr-4 text-[var(--color-primary)]" /> Hardware &
            Software
          </h3>
          <div class="flex space-x-2">
            <button
              class="prev-btn p-4 rounded-full glass hover:bg-white/10 transition-colors z-40"
            >
              <ChevronLeft class="w-8 h-8 text-white" />
            </button>
            <button
              class="next-btn p-4 rounded-full glass hover:bg-white/10 transition-colors z-40"
            >
              <ChevronRight class="w-8 h-8 text-white" />
            </button>
          </div>
        </div>
        <div
          class="carousel-content relative h-[650px] w-full flex justify-center items-center"
          style="perspective: 1200px;"
        >
          <div
            class="carousel-item absolute w-[95%] md:w-[75%] h-[600px] glass p-6 rounded-3xl border border-white/10 cursor-pointer flex flex-col justify-center text-center group"
          >
            <h4 class="text-2xl font-bold text-[var(--color-primary)] mb-4">
              3D Prints Pitch
            </h4>
            <div class="flex-grow w-full rounded-xl overflow-hidden shadow-inner bg-white/5 relative z-50">
              <iframe src="/documents/POST_3dPrints_pitch.pdf#view=FitH" class="w-full h-full border-0 pointer-events-auto"></iframe>
            </div>
            <a href="/documents/POST_3dPrints_pitch.pdf" target="_blank" class="text-sm mt-3 text-[var(--color-text-muted)] hover:text-white transition-colors relative z-50 pointer-events-auto">Open fullscreen</a>
          </div>
          <div
            class="carousel-item absolute w-[95%] md:w-[75%] h-[600px] glass p-6 rounded-3xl border border-white/10 cursor-pointer flex flex-col justify-center text-center group"
          >
            <h4 class="text-2xl font-bold text-[var(--color-primary)] mb-4">
              Mido Pitch Presentation
            </h4>
            <div class="flex-grow w-full rounded-xl overflow-hidden shadow-inner bg-white/5 relative z-50">
              <iframe src="/documents/Mido%20pitch%20presentation.pdf#view=FitH" class="w-full h-full border-0 pointer-events-auto"></iframe>
            </div>
            <a href="/documents/Mido%20pitch%20presentation.pdf" target="_blank" class="text-sm mt-3 text-[var(--color-text-muted)] hover:text-white transition-colors relative z-50 pointer-events-auto">Open fullscreen</a>
          </div>
          <div
            class="carousel-item absolute w-[95%] md:w-[75%] h-[600px] glass p-6 rounded-3xl border border-white/10 cursor-pointer flex flex-col justify-center text-center group"
          >
            <h4 class="text-2xl font-bold text-[var(--color-primary)] mb-4">
              WellFed Pitch Presentation
            </h4>
            <div class="flex-grow w-full rounded-xl overflow-hidden shadow-inner bg-white/5 relative z-50">
              <iframe src="/documents/WellFed_Slides.pdf#view=FitH" class="w-full h-full border-0 pointer-events-auto"></iframe>
            </div>
            <a href="/documents/WellFed_Slides.pdf" target="_blank" class="text-sm mt-3 text-[var(--color-text-muted)] hover:text-white transition-colors relative z-50 pointer-events-auto">Open fullscreen</a>
          </div>
          <div
            class="carousel-item absolute w-[95%] md:w-[75%] h-[380px] glass p-10 rounded-3xl border border-white/10 cursor-pointer flex flex-col justify-center text-center group"
          >
            <h4 class="text-3xl font-bold text-[var(--color-primary)] mb-4">
              Autonomous Lane Detection Core
            </h4>
            <p class="text-[0.95rem] text-[var(--color-text-muted)] leading-relaxed mb-4">
              Engineered a highly accurate deep-learning pipeline for real-time semantic lane segmentation. Leveraging a sophisticated Encoder-Decoder CNN architecture (SegNet), this solution lays the groundwork for next-generation autonomous driving systems.
            </p>
            <p class="text-[0.95rem] text-[var(--color-text-muted)] leading-relaxed mb-4">
              <strong class="text-white">Key Contributions:</strong> Architected critical performance analysis scripts to rigorously evaluate model accuracy under edge cases, and expanded global accessibility by integrating full French localization for international engineering teams.
            </p>
            <a href="https://github.com/Fasepulveda/Lane-Detection" target="_blank" class="inline-block mx-auto px-8 py-4 mt-auto rounded-full bg-[var(--color-primary)] text-[var(--color-bg)] font-bold text-lg transition-transform hover:scale-105 relative z-50 pointer-events-auto shadow-[0_0_15px_rgba(var(--color-primary-rgb),0.3)]">
              Explore the Architecture
            </a>
          </div>
          <div
            class="carousel-item absolute w-[95%] md:w-[75%] h-[380px] glass p-10 rounded-3xl border border-white/10 cursor-pointer flex flex-col justify-center text-center group"
          >
            <h4 class="text-3xl font-bold text-[var(--color-primary)] mb-4">
              YOLOv8 Cut-In Detection System
            </h4>
            <p class="text-[0.95rem] text-[var(--color-text-muted)] leading-relaxed mb-4">
              Developed a cutting-edge collision avoidance framework utilizing state-of-the-art YOLOv8 object detection. The system dynamically computes Time to Collision (TTC) and adapts to unstructured, unmarked roadways to instantly predict dangerous vehicle cut-ins.
            </p>
            <p class="text-[0.95rem] text-[var(--color-text-muted)] leading-relaxed mb-4">
              <strong class="text-white">Key Contributions:</strong> Authored essential deployment profiling scripts to aggressively optimize inference speeds for edge devices, alongside spearheading French localization to broaden the tool's impact across global markets.
            </p>
            <a href="https://github.com/Fasepulveda/Vehicle_Cut-In_Detection-YOLO-" target="_blank" class="inline-block mx-auto px-8 py-4 mt-auto rounded-full bg-[var(--color-primary)] text-[var(--color-bg)] font-bold text-lg transition-transform hover:scale-105 relative z-50 pointer-events-auto shadow-[0_0_15px_rgba(var(--color-primary-rgb),0.3)]">
              Explore the Architecture
            </a>
          </div>
        </div>
      </div>

      <!-- Cooking Carousel -->
      <div id="carousel-cooking" class="hobby-carousel hidden relative z-10">
        <div class="flex items-center justify-between mb-8">
          <h3 class="text-4xl font-bold text-white flex items-center">
            <ChefHat class="w-10 h-10 mr-4 text-[var(--color-accent)]" /> Cooking
            Adventures
          </h3>
          <div class="flex space-x-2">
            <button
              class="prev-btn p-4 rounded-full glass hover:bg-white/10 transition-colors z-40"
            >
              <ChevronLeft class="w-8 h-8 text-white" />
            </button>
            <button
              class="next-btn p-4 rounded-full glass hover:bg-white/10 transition-colors z-40"
            >
              <ChevronRight class="w-8 h-8 text-white" />
            </button>
          </div>
        </div>
        <div
          class="carousel-content relative h-[450px] w-full flex justify-center items-center"
          style="perspective: 1200px;"
        >
          <div
            class="carousel-item absolute w-[95%] md:w-[75%] h-[380px] glass overflow-hidden rounded-3xl border border-white/10 cursor-pointer flex flex-col group"
          >
            <div class="absolute inset-0 w-full h-full">
              <img src="/images/steak_frites_1784989542166.png" alt="Steak Frites" class="w-full h-full object-cover opacity-60 group-hover:scale-105 group-hover:opacity-50 transition-all duration-700" />
              <div class="absolute inset-0 bg-gradient-to-t from-black/90 via-black/60 to-transparent"></div>
            </div>
            <div class="relative z-10 flex flex-col justify-end h-full p-8 text-left">
              <h4 class="text-3xl font-bold text-[var(--color-accent)] mb-4">
                Steak Frites
              </h4>
              <p class="text-[0.95rem] text-[var(--color-text-muted)] leading-relaxed">
                The quintessential French bistro classic. Achieving the perfect crust on a tender steak, paired with golden, crispy, twice-fried potatoes, is a study in precise temperature control and timing.
              </p>
            </div>
          </div>
          <div
            class="carousel-item absolute w-[95%] md:w-[75%] h-[380px] glass overflow-hidden rounded-3xl border border-white/10 cursor-pointer flex flex-col group"
          >
            <div class="absolute inset-0 w-full h-full">
              <img src="/images/boeuf_bourguignon_1784989548965.png" alt="Boeuf Bourguignon" class="w-full h-full object-cover opacity-60 group-hover:scale-105 group-hover:opacity-50 transition-all duration-700" />
              <div class="absolute inset-0 bg-gradient-to-t from-black/90 via-black/60 to-transparent"></div>
            </div>
            <div class="relative z-10 flex flex-col justify-end h-full p-8 text-left">
              <h4 class="text-3xl font-bold text-[var(--color-accent)] mb-4">
                Boeuf Bourguignon
              </h4>
              <p class="text-[0.95rem] text-[var(--color-text-muted)] leading-relaxed">
                A rich, slow-simmered masterpiece of French countryside cooking. Developing the deep, complex flavors of beef, red wine, pearl onions, and mushrooms requires patience and a passion for foundational culinary techniques.
              </p>
            </div>
          </div>
          <div
            class="carousel-item absolute w-[95%] md:w-[75%] h-[380px] glass overflow-hidden rounded-3xl border border-white/10 cursor-pointer flex flex-col group"
          >
            <div class="absolute inset-0 w-full h-full">
              <img src="/images/grilled_chicken_1784989557448.png" alt="Perfectly Grilled Chicken" class="w-full h-full object-cover opacity-60 group-hover:scale-105 group-hover:opacity-50 transition-all duration-700" />
              <div class="absolute inset-0 bg-gradient-to-t from-black/90 via-black/60 to-transparent"></div>
            </div>
            <div class="relative z-10 flex flex-col justify-end h-full p-8 text-left">
              <h4 class="text-3xl font-bold text-[var(--color-accent)] mb-4">
                Perfectly Grilled Chicken
              </h4>
              <p class="text-[0.95rem] text-[var(--color-text-muted)] leading-relaxed">
                The ultimate test of fundamental cooking skills. Elevating a simple cut of poultry into a juicy, flavor-packed dish with charred, smoky edges involves careful marination, heat management, and resting times.
              </p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</Layout>

<script>
  function initHobbies() {
    const cards = document.querySelectorAll(".hobby-card");
    const detailView = document.getElementById("detail-view");
    const carousels = document.querySelectorAll(".hobby-carousel");
    const caret = document.getElementById("tab-caret");

    let activeCard = null;

    cards.forEach((card) => {
      card.addEventListener("click", () => {
        // If clicking the already active card, close it
        if (activeCard === card) {
          card.classList.remove(
            "ring-2",
            "ring-white/50",
            "bg-white/10",
            "-translate-y-4",
            "shadow-2xl",
          );
          card.classList.add("hover:-translate-y-2");
          detailView.classList.add("hidden");
          detailView.classList.remove("animate-fade-in-up");
          activeCard = null;
          return;
        }

        // Remove active state from all
        cards.forEach((c) => {
          c.classList.remove(
            "ring-2",
            "ring-white/50",
            "bg-white/10",
            "-translate-y-4",
            "shadow-2xl",
          );
          c.classList.add("hover:-translate-y-2");
        });

        // Add active state to clicked
        card.classList.add(
          "ring-2",
          "ring-white/50",
          "bg-white/10",
          "-translate-y-4",
          "shadow-2xl",
        );
        card.classList.remove("hover:-translate-y-2");
        activeCard = card;

        // Hide all carousels
        carousels.forEach((c) => c.classList.add("hidden"));

        // Show detail view container
        if (detailView) {
          detailView.classList.remove("hidden");
          detailView.classList.add("animate-fade-in-up");

          // Position the caret arrow to point to the active card
          if (caret) {
            const cardRect = card.getBoundingClientRect();
            const detailRect = detailView.getBoundingClientRect();
            // Calculate relative left position (center of the card)
            const relativeLeft =
              cardRect.left - detailRect.left + cardRect.width / 2;

            // We use transform in CSS to perfectly center the rotated box on this left coordinate
            caret.style.left = `${relativeLeft}px`;
            caret.classList.remove("hidden");
          }
        }

        // Show matching carousel
        const target = card.getAttribute("data-target");
        if (target) {
          const activeCarousel = document.getElementById(target);
          if (activeCarousel) {
            activeCarousel.classList.remove("hidden");
            // Trigger update to set positions correctly on first render
            const event = new Event("updateCarousel");
            activeCarousel.dispatchEvent(event);
          }
        }

        // Scroll nicely to show the bottom of the detail view,
        // with a little extra buffer so it's not flush against the screen's bottom.
        setTimeout(() => {
          if (detailView) {
            const rect = detailView.getBoundingClientRect();
            const buffer = 60; // Extra pixels of buffer at the bottom
            const offset = window.scrollY + rect.bottom - window.innerHeight + buffer;
            
            window.scrollTo({
              top: offset,
              behavior: "smooth",
            });
          }
        }, 100);
      });
    });

    // Initialize 3D Wheel Carousel logic
    carousels.forEach((carousel) => {
      const prevBtn = carousel.querySelector(".prev-btn");
      const nextBtn = carousel.querySelector(".next-btn");
      const items = carousel.querySelectorAll(".carousel-item");
      let currentIndex = 0;
      const total = items.length;

      const updateCarousel = () => {
        items.forEach((item, index) => {
          item.style.transition = "all 600ms cubic-bezier(0.25, 0.8, 0.25, 1)";

          if (index === currentIndex) {
            // Center active item
            item.style.transform = "translateX(0) scale(1) translateZ(0)";
            item.style.opacity = "1";
            item.style.zIndex = "30";
            item.style.filter = "brightness(1)";
          } else if (index === (currentIndex - 1 + total) % total) {
            // Left item
            item.style.transform =
              "translateX(-55%) scale(0.85) translateZ(-100px)";
            item.style.opacity = "0.4";
            item.style.zIndex = "20";
            item.style.filter = "brightness(0.6)";
          } else if (index === (currentIndex + 1) % total) {
            // Right item
            item.style.transform =
              "translateX(55%) scale(0.85) translateZ(-100px)";
            item.style.opacity = "0.4";
            item.style.zIndex = "20";
            item.style.filter = "brightness(0.6)";
          } else {
            // Hidden items (if more than 3)
            item.style.transform =
              "translateX(0) scale(0.5) translateZ(-200px)";
            item.style.opacity = "0";
            item.style.zIndex = "10";
            item.style.pointerEvents = "none";
          }
        });
      };

      // Listen for custom event to re-layout when unhidden
      carousel.addEventListener("updateCarousel", updateCarousel);

      // Add click to items so you can click side items to bring them center
      items.forEach((item, index) => {
        item.addEventListener("click", () => {
          if (currentIndex !== index) {
            currentIndex = index;
            updateCarousel();
          }
        });
      });

      if (prevBtn) {
        prevBtn.addEventListener("click", (e) => {
          e.stopPropagation();
          currentIndex = currentIndex > 0 ? currentIndex - 1 : items.length - 1;
          updateCarousel();
        });
      }

      if (nextBtn) {
        nextBtn.addEventListener("click", (e) => {
          e.stopPropagation();
          currentIndex = currentIndex < items.length - 1 ? currentIndex + 1 : 0;
          updateCarousel();
        });
      }

      // Initial call
      updateCarousel();
    });
  }

  // Run on initial load
  initHobbies();

